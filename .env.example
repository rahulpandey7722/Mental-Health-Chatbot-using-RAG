# ====================================================================
# MindHaven - Deployment & Runtime Configuration
# ====================================================================

# Backend Server Settings
PORT=8000
HOST=0.0.0.0
RELOAD=false

# CORS Origins (comma-separated for specific domains, or * for open access)
# Examples: 
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Frontend API Target (Vite Environment Variable)
# - Leave empty/unset when frontend and backend are hosted together in a single container or service.
# - Set to your deployed backend URL when deploying frontend on Vercel/Netlify separately:
# VITE_API_BASE_URL=https://mindhaven-api.onrender.com
